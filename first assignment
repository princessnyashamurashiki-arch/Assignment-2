#A log-processing service receives continuous streams of timestamps representing user logins.
#Write a Python function find_peak_usage(logs) that determines the hour of the day (0–23) that experienced the highest volume of logins.
#Requirements:
#Input logs is a list of ISO-formatted timestamp strings (e.g., "2026-08-04T13:21:18").
#Return an integer representing the peak hour (0–23). If there is a tie, return the earliest hour.
#Do not use external libraries like pandas (built-in modules such as datetime or collections are allowed).

#ANSWER
from datetime import datetime

def find_peak_usage(logs):
    # Create a list to store the number of logins for each hour
    hourly_count = [0] * 24

    # Process each timestamp
    for timestamp in logs:
        time = datetime.fromisoformat(timestamp)
        hourly_count[time.hour] += 1

    # Find the hour with the highest number of logins
    peak_hour = hourly_count.index(max(hourly_count))

    return peak_hour


# Example usage
logs = [
    "2026-08-04T13:21:18",
    "2026-08-04T13:45:10",
    "2026-08-04T09:15:20",
    "2026-08-04T13:55:30",
    "2026-08-04T09:30:45",
    "2026-08-04T18:10:12"
]

print("Peak usage hour:", find_peak_usage(logs))

Output:

Peak usage hour: 13

hourly_count.index(max(hourly_count)) returns the first occurrence of the maximum value, so if two or more hours have the same highest number of logins, the earliest hour is returned.